# Local environment for live testnet operations.
# Copy this file to .env and fill in local values.
# Never commit .env.

# Sepolia RPC endpoint. Prefer a private endpoint for reliability.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# EOA used for contract deployment and registry write operations in local demos.
# Use a testnet-only key. Do not use production funds.
TEST_PRIVATE_KEY=

# Optional admin gate for demo-only seller-agent registration and admin actions.
DEMO_ADMIN_TOKEN=

# Cobo Agentic Wallet credentials are read by the local `caw` CLI.
# Do not put CAW API keys or wallet credentials in this file unless your local
# CAW setup explicitly requires it, and never commit them.
